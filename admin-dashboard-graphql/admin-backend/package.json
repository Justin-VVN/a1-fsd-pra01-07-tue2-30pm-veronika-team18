{
  "name": "admin-backend-graphql",
  "version": "1.0.0",
  "description": "Admin GraphQL backend for Venue Vendor dashboard",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec \"ts-node src/index.ts\" --watch src --ext ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@graphql-tools/schema": "^10.0.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "graphql": "^16.10.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.16.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.5.5",
    "reflect-metadata": "^0.2.1",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.28",
    "typescript": "^5.3.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.12",
    "nodemon": "^3.1.0",
    "ts-node-dev": "^2.0.0"
